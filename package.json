{
	"name": "@blackswampai/n8n-nodes-novu",
	"version": "0.1.0",
	"packageManager": "npm@11.19.0",
	"private": true,
	"description": "Independent n8n community node for Novu notification workflows",
	"license": "MIT",
	"homepage": "https://blackswampai.com/n8n-nodes/novu/",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"novu",
		"notifications"
	],
	"author": {
		"name": "Christopher J. Nelson",
		"email": "christopherjnelson@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/BlackSwampAI/n8n-nodes-novu.git"
	},
	"bugs": {
		"url": "https://github.com/BlackSwampAI/n8n-nodes-novu/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"test:unit": "vitest run",
		"release:check": "node scripts/release-check.mjs",
		"scan:source": "node scripts/scan-source.mjs",
		"smoke:load": "node scripts/node-load-smoke.mjs",
		"smoke:install": "node scripts/package-install-smoke.mjs",
		"package:check": "npm run release:check && npm pack --dry-run --json --cache .npm-cache | node scripts/validate-pack.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/NovuApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Novu/Novu.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.46.4",
		"@n8n/scan-community-package": "0.34.0",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"allowScripts": {
		"eslint-plugin-n8n-nodes-base": false
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
